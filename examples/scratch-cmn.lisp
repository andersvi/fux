(in-package :fux)

;;
;; generates output to cmn - Common Music Notation - files.
;; 
;; Get cmn here: https://ccrma.stanford.edu/software/cmn/
;; 



(defmacro scratch-cmn (&whole whole generator-form name
                       &key
			 (mode :dorian) staff-order
                         (score-notes :auto)
			 (size 20))
  `(let* ((records ,generator-form)
          (best (fux:best-counterpoint records))
          (stem ,name))
     (when best
       (with-open-file (s (format nil "~A.cmn" stem)
                          :direction :output
                          :if-exists :supersede)
         (format s ";;; Generated by:~2%;;;~%;;;~%")
         (with-input-from-string
             (input
              (with-output-to-string (out)
                (let ((*print-pretty* t)
		      (*print-case* :downcase))
                  (write ',whole :stream out))))
           (loop for line = (read-line input nil nil)
                 while line
                 do (format s ";;; ~A~%" line)))
	 (format s ";;;~2%")
         (fux:write-counterpoint-cmn best :stream s
					  :output-file (format nil "~A.eps" stem)
					  :size ,size
					  :mode ,mode
					  :staff-order ,staff-order
					  :score-notes
					  (if (eq ,score-notes :auto)
					      (if (getf best :search-local-costs) :search nil)
					      ,score-notes))))
     best))
